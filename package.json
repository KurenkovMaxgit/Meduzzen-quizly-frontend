{
  "name": "quizly-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:diff": "prettier --list-different . --ignore-unknown",
    "docker:build": "docker-compose --env-file ./.env.production.local -f docker-compose.yml build",
    "docker:up": "docker-compose --env-file ./.env.production.local -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.16.1",
    "@primereact/core": "^11.0.0-alpha.10",
    "@primereact/types": "^11.0.0-alpha.10",
    "@primereact/ui": "^11.0.0-alpha.10",
    "@primeuix/themes": "^2.0.3",
    "@reduxjs/toolkit": "^2.11.2",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.5",
    "next": "^16.2.0",
    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "primeicons": "^7.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-redux": "^9.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-primeui": "^0.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,mts,cts,tsx,js,mjs,cjs,jsx}": [
      "prettier -w",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": "prettier -w"
  }
}
